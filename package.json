{
  "name": "talenthub-api",
  "version": "1.0.0",
  "description": "TalentHub is a backend recruitment platform that bridges the gap between job seekers and employers. Candidates can create professional profiles, search and apply for jobs, while employers can publish job openings, review applications, and manage hiring workflows.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "test": "node --test --allow-no-tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NwankwoMichael/TalentHub-API.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/NwankwoMichael/TalentHub-API/issues"
  },
  "homepage": "https://github.com/NwankwoMichael/TalentHub-API#readme",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/pino": "^7.0.4",
    "@types/pino-pretty": "^4.7.5",
    "pino": "^10.4.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  }
}
